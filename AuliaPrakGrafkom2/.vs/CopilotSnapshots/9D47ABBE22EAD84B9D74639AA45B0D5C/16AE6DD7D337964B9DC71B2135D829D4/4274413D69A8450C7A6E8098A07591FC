        // ============================================================
        // ALGORITMA 2.1 - GARIS DASAR
        // Gradien m = (y2-y1)/(x2-x1), iterasi x dengan dx = 1,
        // y dinaikkan sebesar m setiap langkah.
        // ============================================================
        private void DrawLineDasar(Panel canvas, int x1, int y1, int x2, int y2)
        {
            Brush brush = Brushes.Blue;

            // Kasus khusus: garis vertikal (x1 == x2), gradien tak terdefinisi
            if (x1 == x2)
            {
                int yStart = Math.Min(y1, y2);
                int yEnd = Math.Max(y1, y2);
                for (int y = yStart; y <= yEnd; y++)
                {
                    PutPixel(canvas, x1, y, brush);
                }
                return;
            }

            // Pastikan iterasi selalu dari x kecil ke x besar (x1 <= x2)
            if (x1 > x2)
            {
                (x1, x2) = (x2, x1);
                (y1, y2) = (y2, y1);
            }

            double m = (double)(y2 - y1) / (x2 - x1);
            double y = y1;

            for (int x = x1; x <= x2; x++)
            {
                PutPixel(canvas, x, (int)Math.Round(y), brush);
                y += m; // y* = y + m
            }
        }

        // ============================================================
        // ALGORITMA 2.2 - GARIS DDA (Digital Differential Analyzer)
        // Langkah s = max(|dx|, |dy|), inkremen dx/s dan dy/s.
        // ============================================================
        private void DrawLineDDA(Panel canvas, int x1, int y1, int x2, int y2)
        {
            Brush brush = Brushes.DarkGreen;

            int dx = x2 - x1;
            int dy = y2 - y1;

            // Jumlah langkah = selisih terpanjang agar garis tidak putus
            int steps = Math.Max(Math.Abs(dx), Math.Abs(dy));

            // Garis berupa satu titik (x1==x2 dan y1==y2)
            if (steps == 0)
            {
                PutPixel(canvas, x1, y1, brush);
                return;
            }

            double xInc = (double)dx / steps;
            double yInc = (double)dy / steps;

            double x = x1;
            double y = y1;

            for (int i = 0; i <= steps; i++)
            {
                PutPixel(canvas, (int)Math.Round(x), (int)Math.Round(y), brush);
                x += xInc;
                y += yInc;
            }
        }

        // ============================================================
        // ALGORITMA 2.3 - GARIS BRESENHAM (8 OKTAN, INTEGER PENUH)
        // Parameter keputusan d = 2*db - da; langkah lurus (m1) atau
        // diagonal (m2) dipilih berdasarkan tanda d.
        // ============================================================
        private void DrawLineBresenham(Panel canvas, int x1, int y1, int x2, int y2)
        {
            Brush brush = Brushes.Red;

            int dx = x2 - x1;
            int dy = y2 - y1;
            int absDx = Math.Abs(dx);
            int absDy = Math.Abs(dy);

            int x = x1;
            int y = y1;

            // da = sumbu dominan (langkah selalu diambil), db = sumbu minor
            int da = Math.Max(absDx, absDy);
            int db = Math.Min(absDx, absDy);

            // Parameter keputusan awal
            int d = 2 * db - da;

            // Tentukan langkah lurus (m1) dan langkah diagonal (m2)
            // berdasarkan tanda dx, dy, dan sumbu dominan
            int m1x, m1y, m2x, m2y;
            if (absDx >= absDy)
            {
                // Sumbu X dominan: langkah lurus = geser X saja
                m1x = Math.Sign(dx); m1y = 0;
                m2x = Math.Sign(dx); m2y = Math.Sign(dy);
            }
            else
            {
                // Sumbu Y dominan: langkah lurus = geser Y saja
                m1x = 0; m1y = Math.Sign(dy);
                m2x = Math.Sign(dx); m2y = Math.Sign(dy);
            }

            PutPixel(canvas, x, y, brush);

            // Iterasi maksimal da langkah sampai mencapai titik akhir
            for (int i = 0; i < da; i++)
            {
                if (d >= 0)
                {
                    // Langkah diagonal: kedua sumbu bergeser
                    x += m2x;
                    y += m2y;
                    d += 2 * db - 2 * da;
                }
                else
                {
                    // Langkah lurus: hanya sumbu dominan bergeser
                    x += m1x;
                    y += m1y;
                    d += 2 * db;
                }
                PutPixel(canvas, x, y, brush);

                if (x == x2 && y == y2)
                {
                    break;
                }
            }
        }

        // ============================================================
        // ALGORITMA 2.4 - LINGKARAN DASAR
        // Persamaan lingkaran y = yc +/- sqrt(r^2 - x^2),
        // iterasi x dari -r sampai r.
        // ============================================================
        private void DrawCircleDasar(Panel canvas, int xc, int yc, int r)
        {
            Brush brush = Brushes.Blue;

            for (int x = -r; x <= r; x++)
            {
                double yOffset = Math.Sqrt(r * r - x * x);
                double y1 = yc + yOffset; // setengah lingkaran atas
                double y2 = yc - yOffset; // setengah lingkaran bawah

                PutPixel(canvas, xc + x, (int)Math.Round(y1), brush);
                PutPixel(canvas, xc + x, (int)Math.Round(y2), brush);
            }
        }

        // ============================================================
        // ALGORITMA 2.5 - LINGKARAN POLAR
        // x = xc + r*cos(theta), y = yc + r*sin(theta),
        // theta dari 0 sampai 2*PI dengan step kecil.
        // ============================================================
        private void DrawCirclePolar(Panel canvas, int xc, int yc, int r)
        {
            Brush brush = Brushes.DarkGreen;

            // Step sudut 1/r agar busur antar piksel <= 1 satuan (tidak putus),
            // dibatasi maksimum 0.005 radian untuk radius kecil.
            double step = Math.Min(1.0 / r, 0.005);

            for (double theta = 0; theta <= 2 * Math.PI; theta += step)
            {
                double x = xc + r * Math.Cos(theta);
                double y = yc + r * Math.Sin(theta);
                PutPixel(canvas, (int)Math.Round(x), (int)Math.Round(y), brush);
            }
        }

        // ============================================================
        // ALGORITMA 2.6 & 2.7 - LINGKARAN BRESENHAM (MIDPOINT CIRCLE)
        // Hanya menghitung satu oktan, lalu dicerminkan ke 8 titik
        // simetris. Parameter keputusan d = 3 - 2r.
        // ============================================================
        private void DrawCircleBresenham(Panel canvas, int xc, int yc, int r)
        {
            Brush brush = Brushes.Red;

            int x = 0;
            int y = r;
            int d = 3 - (2 * r);

            DrawCirclePoints(canvas, xc, yc, x, y, brush);

            while (x <= y)
            {
                x++;
                if (d < 0)
                {
                    d = d + (4 * x) + 6;
                }
                else
                {
                    d = d + 4 * (x - y) + 10;
                    y--;
                }
                DrawCirclePoints(canvas, xc, yc, x, y, brush);
            }
        }

        /// <summary>
        /// Menggambar 8 titik simetris oktan lingkaran dari satu titik (x, y).
        /// </summary>
        private void DrawCirclePoints(Panel canvas, int xc, int yc, int x, int y, Brush brush)
        {
            PutPixel(canvas, xc + x, yc + y, brush);
            PutPixel(canvas, xc - x, yc + y, brush);
            PutPixel(canvas, xc + x, yc - y, brush);
            PutPixel(canvas, xc - x, yc - y, brush);
            PutPixel(canvas, xc + y, yc + x, brush);
            PutPixel(canvas, xc - y, yc + x, brush);
            PutPixel(canvas, xc + y, yc - x, brush);
            PutPixel(canvas, xc - y, yc - x, brush);
        }
