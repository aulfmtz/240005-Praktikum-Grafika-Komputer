        /// <summary>
        /// Membuat satu kanvas (Panel) beserta label judul di atasnya,
        /// lengkap dengan Bitmap back-buffer dan event Paint.
        /// </summary>
        private Panel CreateCanvas(string title, int x, int y)
        {
            var lbl = new Label
            {
                Text = title,
                AutoSize = true,
                Location = new Point(x, y)
            };
            Controls.Add(lbl);

            var panel = new Panel
            {
                Location = new Point(x, y + 22),
                Size = new Size(CanvasSize, CanvasSize),
                BorderStyle = BorderStyle.FixedSingle,
                BackColor = Color.White
            };

            // Back-buffer: gambar disimpan di Bitmap, event Paint hanya meng-copy-nya
            var bmp = new Bitmap(CanvasSize, CanvasSize);
            using (var g = Graphics.FromImage(bmp))
            {
                g.Clear(Color.White);
            }
            canvasBuffers[panel] = bmp;

            panel.Paint += (s, e) =>
            {
                e.Graphics.DrawImageUnscaled(canvasBuffers[(Panel)s!], 0, 0);
            };

            Controls.Add(panel);
            return panel;
        }

