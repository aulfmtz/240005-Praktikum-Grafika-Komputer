        /// <summary>
        /// Menggambar satu piksel pada konteks Graphics.
        /// Ukuran 2x2 agar piksel jelas terlihat pada layar resolusi tinggi.
        /// </summary>
        private void PutPixel(Graphics g, int x, int y, Brush brush)
        {
            g.FillRectangle(brush, x, y, 2, 2);
        }

        /// <summary>Menggambar satu piksel langsung ke back-buffer kanvas.</summary>
        private void PutPixel(Panel canvas, int x, int y, Brush brush)
        {
            using var g = Graphics.FromImage(canvasBuffers[canvas]);
            PutPixel(g, x, y, brush);
        }

        private void ClearCanvas(Panel canvas)
        {
            using var g = Graphics.FromImage(canvasBuffers[canvas]);
            g.Clear(Color.White);
            canvas.Invalidate();
        }

